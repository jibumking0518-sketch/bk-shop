{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/api?__path=/admin"
    },
    {
      "source": "/admin/",
      "destination": "/api?__path=/admin"
    },
    {
      "source": "/admin.html",
      "destination": "/api?__path=/admin"
    },
    {
      "source": "/pierce",
      "destination": "/pierce.html"
    },
    {
      "source": "/buds",
      "destination": "/pierce.html"
    },
    {
      "source": "/buds.html",
      "destination": "/pierce.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
